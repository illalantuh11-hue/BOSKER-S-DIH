-- ===== STEALTH FUNCTIONS =====
local stealthGen = nil
local stealthOriginalCollisions = {}

local function enterGenStealth(gen)
    if stealthGen or not gen or not config.stealthFarm then return end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    stealthOriginalCollisions = {}
    for _, part in ipairs(gen:GetDescendants()) do
        if part:IsA("BasePart") then
            stealthOriginalCollisions[part] = part.CanCollide
            part.CanCollide = false
        end
    end

    local ok, bb = pcall(function() return gen:GetBoundingBox() end)
    local targetPos = ok and bb.Position or gen:GetPivot().Position

    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero
    hrp.CFrame = CFrame.new(targetPos)

    stealthGen = gen
end

local function exitGenStealth()
    if not stealthGen then return end
    for obj, state in pairs(stealthOriginalCollisions) do
        if obj.Parent then
            obj.CanCollide = state
        end
    end
    stealthOriginalCollisions = {}
    stealthGen = nil
end

-- ===== CORE FUNCTIONS =====
local function safeTP(targetPos)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        hrp.CFrame = CFrame.new(targetPos + Vector3.new(0, 3, 0))
    end
end

local function getPos(obj)
    if obj:IsA("Model") then
        local primary = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)
        return primary and primary.Position or obj:GetPivot().Position
    elseif obj:IsA("BasePart") then
        return obj.Position
    end
    return Vector3.zero
end

local function getCurrentFloorFolder()
    for _, child in ipairs(workspace:GetChildren()) do
        local n = child.Name:lower()
        if n:find("current") or n:find("floor") then return child end
    end
    return workspace
end

local function getGenerators()
    local list = {}
    local floor = getCurrentFloorFolder()
    if floor and floor ~= workspace then
        for _, obj in ipairs(floor:GetDescendants()) do
            if obj:IsA("Model") and (obj.Name == "Genorator" or obj.Name == "GenoratorBosker") then
                table.insert(list, obj)
            end
        end
    else
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Model") and (obj.Name == "Genorator" or obj.Name == "GenoratorBosker") then
                if obj.Parent ~= workspace then table.insert(list, obj) end
            end
        end
    end
    return list
end

local function isGenComplete(gen)
    local fill = gen:FindFirstChild("Fill")
    if fill and fill:IsA("NumberValue") and fill.Value >= 100 then return true end

    local useable = gen:FindFirstChild("Useable")
    if useable and useable:IsA("BoolValue") and not useable.Value then return true end

    local hasExtract = false
    for _, p in ipairs(gen:GetDescendants()) do
        if p:IsA("ProximityPrompt") and p.Enabled then
            local txt = p.ActionText:lower()
            if txt:find("extract") and not txt:find("stop") then hasExtract = true; break end
        end
    end
    if not hasExtract then return true end
    return false
end

-- Мгновенное заполнение генератора
local function instantFillGen(gen)
    if not gen then return end
    local fillVal = gen:FindFirstChild("Fill")
    if fillVal and fillVal:IsA("NumberValue") then
        fillVal.Value = 100
    end
    pcall(function()
        if Events and Events:FindFirstChild("SkillCheck") then
            Events.SkillCheck:FireServer(gen.Name, true)
        end
    end)
end

local function getSafeData()
    local list = {}
    local floor = getCurrentFloorFolder()
    for _, obj in ipairs(floor:GetDescendants()) do
        if obj:IsA("Model") and obj.Name == "Data" then
            local evil = obj:FindFirstChild("Evil")
            if not (evil and evil:IsA("StringValue") and evil.Value ~= "") then
                table.insert(list, obj)
            end
        end
    end
    return list
end

local function spamInteract()
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") and obj.Enabled then
            local txt = obj.ActionText:lower()
            if not txt:find("extract") then
                local parent = obj.Parent
                local pPos = parent:IsA("BasePart") and parent.Position or (parent:IsA("Model") and parent:GetPivot().Position)
                if pPos and (pPos - hrp.Position).Magnitude <= 15 then
                    pcall(function() fireproximityprompt(obj) end)
                end
            end
        end
    end
end

