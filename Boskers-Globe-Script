-- Auto Skillcheck
local handledSkillcheck = false
RunService.Heartbeat:Connect(function()
    if not config.autoSkillcheck then return end
    local sk = PlayerGui:FindFirstChild("Skill")
    local fr = sk and sk:FindFirstChild("SkillcheckFrame")
    local sc = fr and fr:FindFirstChild("SkillCheck")

    if fr and sc and fr.Visible and sc.Visible then
        if not handledSkillcheck then
            handledSkillcheck = true
            local activeGenName = "Genorator"
            local gens = getGenerators()
            for i = 1, #gens do
                local gen = gens[i]
                local active = gen:FindFirstChild("Active")
                if active and active:IsA("BoolValue") and active.Value then
                    activeGenName = gen.Name
                    break
                end
            end
            if Events and Events:FindFirstChild("SkillCheck") then
                Events.SkillCheck:FireServer(activeGenName, true)
            end
            fr.Visible = false; sc.Visible = false
        end
    else
        handledSkillcheck = false
    end
end)

