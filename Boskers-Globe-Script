-- ===== HOOK: Fail -> Success =====
if not _G.BoskerHooked and FalledRemote and SkillRemote then
    _G.BoskerHooked = true
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        if config.autoSkillcheck and self == FalledRemote and method == "FireServer" and not checkcaller() then
