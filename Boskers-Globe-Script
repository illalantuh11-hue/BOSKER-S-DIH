-- Dragging
do
    local dragging, startIn, startPos
    title.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging, startIn, startPos = true, i.Position, main.Position
            i.Changed:Connect(function()
                if i.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            local d = i.Position - startIn
            main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
end

-- ===== MAIN LOOP =====
task.spawn(function()
    while gui.Parent do
        task.wait(0.3)
        if not config.autoMode then continue end

        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then
            if stealthGen then exitGenStealth() end
            continue
        end

        local gens = getGenerators()
        local incompleteGens = {}
        local activeGen = nil
        local totalGens = #gens

        for _, gen in ipairs(gens) do
            if not isGenComplete(gen) then
                table.insert(incompleteGens, gen)
                local active = gen:FindFirstChild("Active")
                if active and active:IsA("BoolValue") and active.Value then
                    activeGen = gen
                end
            end
        end

        if totalGens > 0 and #incompleteGens == 0 then
            if stealthGen then exitGenStealth() end
            local elevator = workspace:FindFirstChild("Elevator")
            local targetPos = elevator and getPos(elevator) or CORRECT_ELEVATOR_POS
            safeTP(targetPos)
            spamInteract()
            status.Text = "✅ Generators ready! Looping TP to elevator..."
            status.TextColor3 = Color3.fromRGB(50, 220, 100)

        elseif activeGen then
            if config.stealthFarm and stealthGen ~= activeGen then
                enterGenStealth(activeGen)
            end
            status.Text = "⚡ Farming: " .. activeGen.Name
            status.TextColor3 = Color3.fromRGB(255, 100, 255)

        elseif #incompleteGens > 0 then
            if stealthGen then exitGenStealth() end
            table.sort(incompleteGens, function(a, b)
                return (getPos(a) - hrp.Position).Magnitude < (getPos(b) - hrp.Position).Magnitude
            end)
            local targetGen = incompleteGens[1]

            safeTP(getPos(targetGen))
            instantFillGen(targetGen)
            
            task.delay(0.1, function()
                for _, desc in ipairs(targetGen:GetDescendants()) do
                    if desc:IsA("ProximityPrompt") and desc.Enabled then
                        local txt = desc.ActionText:lower()
                        if txt:find("extract") and not txt:find("stop") then
                            pcall(function() fireproximityprompt(desc) end)
                        end
                    end
                end
            end)
            status.Text = "⚡ Instant Fill: " .. targetGen.Name .. " (" .. #incompleteGens .. " left)"
            status.TextColor3 = Color3.fromRGB(180, 100, 255)

        elseif config.items then
            if stealthGen then exitGenStealth() end
            local safeData = getSafeData()
            if #safeData > 0 then
                local targetData = safeData[1]
                safeTP(getPos(targetData))
                spamInteract()
                status.Text = "🔬 Collecting Data..."
                status.TextColor3 = Color3.fromRGB(100, 255, 150)
            else
                status.Text = "⏳ Waiting..."
                status.TextColor3 = Color3.fromRGB(190, 190, 200)
            end
        end
    end
end)

