local function safeTP(targetPos)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        hrp.CFrame = CFrame.new(targetPos + Vector3.new(0, 3, 0))
    end
end

local function getValvePos(gen)
    local valve = gen:FindFirstChild("Valve", true)
    if valve and valve:IsA("BasePart") then return valve.Position end
    if gen:IsA("Model") then
        local primary = gen.PrimaryPart or gen:FindFirstChildWhichIsA("BasePart", true)
        return primary and primary.Position or gen:GetPivot().Position
    elseif gen:IsA("BasePart") then
        return gen.Position
    end
    return Vector3.zero
end

local function getCurrentFloorFolder()
    for _, child in ipairs(workspace:GetChildren()) do
        local n = child.Name:lower()
        if n:find("current") or n:find("floor") then return child end
    end
    return workspace
end

local function isValidGen(obj)
    if obj:IsA("Model") then
        local name = obj.Name
        return name == "Genorator" or name == "GenoratorBosker" or name == "GenoratorBe"
    end
    return false
end

local function getGenerators()
    local list = {}
    local floor = getCurrentFloorFolder()
    if floor and floor ~= workspace then
        for _, obj in ipairs(floor:GetDescendants()) do
            if isValidGen(obj) then table.insert(list, obj) end
        end
    else
        for _, obj in ipairs(workspace:GetDescendants()) do
            if isValidGen(obj) and obj.Parent ~= workspace then table.insert(list, obj) end
        end
    end
    return list
end

local function isGenComplete(gen)
    local fill = gen:FindFirstChild("Fill")
    if fill and fill:IsA("NumberValue") and fill.Value >= 100 then return true end
    local useable = gen:FindFirstChild("Useable")
    if useable and useable:IsA("BoolValue") and not useable.Value then return true end
    
    local descendants = gen:GetDescendants()
    for i = 1, #descendants do
        local p = descendants[i]
        if p:IsA("ProximityPrompt") and p.Enabled then
            local txt = p.ActionText:lower()
            if txt:find("extract") and not txt:find("stop") then return false end
        end
    end
    return true
end

local filling = {}
local function instantFillGen(gen)
    if not gen or filling[gen] or not SkillRemote then return end
    filling[gen] = true
    task.spawn(function()
        local function fillValue()
            local f = gen:FindFirstChild("Fill", true)
            return (f and f:IsA("NumberValue")) and f.Value or 0
        end

        local descendants = gen:GetDescendants()
        for i = 1, #descendants do
            local d = descendants[i]
            if d:IsA("ProximityPrompt") and d.Enabled then
                local txt = d.ActionText:lower()
                if txt:find("extract") and not txt:find("stop") then
                    pcall(function() fireproximityprompt(d) end)
                end
            end
        end
        task.wait(0.05)

        for i = 1, 40 do
            if not gen.Parent or fillValue() >= 99 then break end
            pcall(function() SkillRemote:FireServer(gen, true) end)
            task.wait(0.01)
        end
        filling[gen] = nil
    end)
end

local function spamInteract()
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local descendants = workspace:GetDescendants()
    for i = 1, #descendants do
        local obj = descendants[i]
        if obj:IsA("ProximityPrompt") and obj.Enabled then
            local txt = obj.ActionText:lower()
            if not txt:find("extract") then
                local parent = obj.Parent
                local pPos = parent:IsA("BasePart") and parent.Position or (parent:IsA("Model") and parent:GetPivot().Position)
                if pPos and (pPos - hrp.Position).Magnitude <= 15 then
                    pcall(function() fireproximityprompt(obj) end)
                end
            end
        end
    end
end

