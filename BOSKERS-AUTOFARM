-- НАСТРОЙКА PLATABOOST
-- ==========================================
getgenv().script_key = getgenv().script_key or "" 
local SERVICE_ID = "37572" -- Твой реальный Service ID из панели Platoboost

local function validatePlatoboostKey()
    if getgenv().script_key == "" then return false end
    
    local hwid = RbxAnalyticsService:GetClientId()
    local url = string.format(
        "https://api.platoboost.com/public/rest?service_id=%s&hwid=%s&key=%s",
        SERVICE_ID,
        hwid,
        tostring(getgenv().script_key)
    )
    
    local success, response = pcall(function()
        return game:HttpGet(url)
    end)
    
    if not success then return false end
    
    local decoded, result = pcall(function()
        return HttpService:JSONDecode(response)
    end)
    
    if decoded and result and result.success then
        return true
    end
    return false
end

-- Если ключ не прошел проверку, прерываем выполнение и показываем ошибку
if not validatePlatoboostKey() then
    local errGui = Instance.new("ScreenGui")
    errGui.Name = "Boskers_Auth_Error"
    errGui.Parent = PlayerGui
    
    local frame = Instance.new("Frame", errGui)
    frame.Size = UDim2.fromOffset(300, 150)
    frame.Position = UDim2.new(0.5, -150, 0.5, -75)
    frame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 8)
    Instance.new("UIStroke", frame).Color = Color3.fromRGB(255, 60, 60)
    
    local txt = Instance.new("TextLabel", frame)
    txt.Size = UDim2.new(1, -20, 1, -20)
    txt.Position = UDim2.new(0, 10, 0, 10)
    txt.BackgroundTransparency = 1
    txt.Text = "Требуется ключ Platoboost!\n\nУкажите ключ в консоли или переменной:\ngetgenv().script_key = \"ВАШ_КЛЮЧ\"\nи перезапустите скрипт."
    txt.TextColor3 = Color3.fromRGB(255, 255, 255)
    txt.TextScaled = true
    txt.Font = Enum.Font.GothamBold
    
    error("Platoboost Auth: Неверный или отсутствующий ключ.")
end

