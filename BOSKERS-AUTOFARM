-- Dragging GUI
do
    local dragging, startIn, startPos
    title.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging, startIn, startPos = true, i.Position, main.Position
            i.Changed:Connect(function()
                if i.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            local d = i.Position - startIn
            main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
end

-- Main Loop
task.spawn(function()
    while gui.Parent do
        task.wait(0.1)
        if not config.autoMode then continue end

        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then continue end

        local gens = getGenerators()
        local incompleteGens = {}
        totalGens = #gens

        for i = 1, #gens do
            local gen = gens[i]
            if not isGenComplete(gen) then
                table.insert(incompleteGens, gen)
            end
        end

        if totalGens > 0 and #incompleteGens == 0 then
            safeTP(CORRECT_ELEVATOR_POS)
            spamInteract()
            status.Text = "Status: Elevator Ready"

        elseif #incompleteGens > 0 then
            table.sort(incompleteGens, function(a, b)
                return (getValvePos(a) - hrp.Position).Magnitude < (getValvePos(b) - hrp.Position).Magnitude
            end)
            local targetGen = incompleteGens[1]

            safeTP(getValvePos(targetGen))
            instantFillGen(targetGen)

            status.Text = "Filling: " .. #incompleteGens .. " left"
        else
            status.Text = "Waiting..."
        end
    end
end)

-- ESP Loop
RunService.RenderStepped:Connect(function()
    if not config.esp then
        local descendants = workspace:GetDescendants()
        for i = 1, #descendants do
            local v = descendants[i]
            if v.Name == "ESP_HL" then v:Destroy() end
        end
        return
    end

    val = getGenerators()
    for i = 1, #val do
        local obj = val[i]
        local hl = obj:FindFirstChild("ESP_HL")
        if not hl then
            hl = Instance.new("Highlight")
            hl.Name = "ESP_HL"
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Parent = obj
        end
        hl.FillColor = isGenComplete(obj) and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(120, 120, 120)
    end
end)

